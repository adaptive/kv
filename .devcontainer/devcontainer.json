{
  "customizations": {
    "vscode": {
      "extensions": ["oxc.oxc-vscode", "github.copilot"],
      "settings": {
        "oxc.path.oxfmt": "oxfmt",
        "oxc.enable.oxlint": false
      }
    }
  },
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "VARIANT": "26-bookworm"
    }
  },
  "postCreateCommand": "pnpm install --frozen-lockfile",
  "runArgs": ["--init"],
  "remoteUser": "node"
}
