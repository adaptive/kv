{
  "name": "@adaptivelink/kv",
  "version": "0.2.2",
  "description": "S3-backed key/value storage for Cloudflare Workers and Fetch-compatible runtimes",
  "module": "./dist/kv.esm.js",
  "types": "./dist/main.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adaptive/kv.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "bugs": {
    "url": "https://github.com/adaptive/kv/issues"
  },
  "homepage": "https://github.com/adaptive/kv#readme",
  "author": "Hugo Romano <hugoromano@gmail.com>",
  "keywords": [
    "cloudflare",
    "stackpath",
    "kv",
    "s3",
    "wasabi",
    "aws",
    "storage",
    "workers",
    "key",
    "values",
    "store",
    "persist",
    "save",
    "config"
  ],
  "license": "MIT",
  "private": false,
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/adaptive"
  },
  "dependencies": {
    "aws4fetch": "1.0.20"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "1.0.0",
    "rollup": "4.64.3",
    "typescript": "7.0.2"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "test": "node --test test/*.test.js",
    "test:types": "tsc -p test/tsconfig.json",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "npm run format:check && npm run build && npm test && npm run test:types",
    "prepack": "npm run build",
    "dry-run": "npm pack --dry-run"
  },
  "type": "module",
  "main": "./dist/kv.esm.js",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/kv.esm.js",
      "default": "./dist/kv.esm.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "packageManager": "pnpm@12.8.1"
}
